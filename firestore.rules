rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function logged() { return request.auth != null; }
  function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
  function manager() { return logged() && exists(userPath()) && get(userPath()).data.role == 'manager'; }
  function participant(t) { return logged() && (t.ownerId == request.auth.uid || t.createdBy == request.auth.uid || request.auth.uid in t.collaborators); }
  function taskPath(id) { return /databases/$(database)/documents/tasks/$(id); }
  function requestPath(id) { return /databases/$(database)/documents/requests/$(id); }
  function statusOnly() {
   return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && request.resource.data.status in ['Pending','In Progress','On Hold','For Approval'];
  }
  function acceptedCollaboratorChange(id) {
   let rid = request.resource.data.get('lastCollabRequestId', '');
   let before = get(requestPath(rid)).data;
   let after = getAfter(requestPath(rid)).data;
   return logged()
     && rid != ''
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators','lastCollabRequestId'])
     && before.taskId == id && before.toId == request.auth.uid && before.status == 'pending'
     && after.status == 'accepted' && after.diff(before).affectedKeys().hasOnly(['status'])
     && !(request.auth.uid in resource.data.collaborators)
     && request.auth.uid in request.resource.data.collaborators
     && request.resource.data.collaborators.size() == resource.data.collaborators.size() + 1
     && request.resource.data.collaborators.hasAll(resource.data.collaborators);
  }
  match /users/{uid} {
   allow read: if logged();
   allow write: if false;
  }
  function activityDelete() {
    return logged() && (manager() || resource.data.ownerId == request.auth.uid)
      && resource.data.get('deletedAt', null) == null
      && request.resource.data.deletedAt is timestamp
      && request.resource.data.activityEvent.type == 'deleted'
      && request.resource.data.activityEvent.by == request.auth.uid
      && request.resource.data.activityEvent.id is string
      && request.resource.data.activityEvent.text is string
      && request.resource.data.activityEvent.text.size() <= 1000
      && request.resource.data.activityReadBy == [request.auth.uid]
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt','activityEvent','activityReadBy']);
  }
  function activityRevision() {
    return logged() && manager() && resource.data.get('deletedAt', null) == null
      && resource.data.status == 'For Approval'
      && request.resource.data.status == 'In Progress'
      && request.resource.data.activityEvent.type == 'revision'
      && request.resource.data.activityEvent.by == request.auth.uid
      && request.resource.data.activityEvent.id is string
      && request.resource.data.activityEvent.text is string
      && request.resource.data.activityEvent.text.size() <= 2500
      && request.resource.data.activityReadBy == [request.auth.uid]
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','activityEvent','activityReadBy']);
  }
  function activityRead() {
    return logged() && resource.data.get('activityEvent', null) != null
      && (manager() || participant(resource.data))
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activityReadBy'])
      && request.resource.data.activityReadBy is list
      && request.resource.data.activityReadBy.size() == resource.data.get('activityReadBy', []).size() + 1
      && request.resource.data.activityReadBy.hasAll(resource.data.get('activityReadBy', []))
      && request.auth.uid in request.resource.data.activityReadBy;
  }
  match /tasks/{id} {
   allow read: if manager() || participant(resource.data);
   allow create: if logged() && request.resource.data.createdBy == request.auth.uid
     && (manager() || request.resource.data.ownerId == request.auth.uid)
     && request.resource.data.collaborators == [] && request.resource.data.status == 'Pending';
   allow update: if resource.data.get('deletedAt', null) == null && ((manager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
     || (participant(resource.data) && statusOnly())
     || acceptedCollaboratorChange(id) || activityDelete() || activityRevision()) || activityRead();
   allow delete: if false; // Soft delete retains record for participant alerts
  }
  match /requests/{id} {
   allow get, list: if logged() && (manager() || resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid);
   allow create: if logged() && request.resource.data.fromId == request.auth.uid
     && request.resource.data.status == 'pending' && request.resource.data.toId != request.auth.uid
     && exists(taskPath(request.resource.data.taskId))
     && (manager() || participant(get(taskPath(request.resource.data.taskId)).data));
   allow update: if (logged() && resource.data.status in ['accepted','declined'] && (resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearedBy']) && !(request.auth.uid in resource.data.get('clearedBy', [])) && request.resource.data.clearedBy.size() == resource.data.get('clearedBy', []).size() + 1 && request.resource.data.clearedBy.hasAll(resource.data.get('clearedBy', [])) && request.auth.uid in request.resource.data.clearedBy) || (logged() && resource.data.toId == request.auth.uid
     && resource.data.status == 'pending'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && (
       request.resource.data.status == 'declined'
       || (request.resource.data.status == 'accepted'
           && exists(taskPath(resource.data.taskId))
           && !(request.auth.uid in get(taskPath(resource.data.taskId)).data.collaborators)
           && request.auth.uid in getAfter(taskPath(resource.data.taskId)).data.collaborators
           && getAfter(taskPath(resource.data.taskId)).data.lastCollabRequestId == id)
     ));
   allow delete: if false;
  }
  match /taskAudit/{id} { allow read: if manager(); allow write: if false; }
  match /notifications/{id} {
   allow read: if logged() && resource.data.toId == request.auth.uid;
   allow create, delete: if false;
   allow update: if logged() && resource.data.toId == request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
     && request.resource.data.read is bool;
  }
 }
}
